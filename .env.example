# ===== DISCORD =====
# Token do seu bot (https://discord.com/developers/applications)
DISCORD_TOKEN=seu_token_do_bot_aqui

# Guild ID do seu servidor (Ativar Developer Mode > Clique direito no servidor > Copiar ID)
ADMIN_GUILD_ID=seu_guild_id_aqui

# Prefixo dos comandos (pode ser mantido como !)
PREFIX=!

# ===== LOGGING =====
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
